{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "html": {
    "parser": {
      "interpolation": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    },
    "enabled": true,
    "includes": [
      "**"
    ]
  },
  "css": {
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/.tmp",
      "!!**/public/maplibre/maplibre-gl-worker-dev.js",
      "!!**/public/maplibre/maplibre-gl-worker.js",
      "!!**/public/maplibre/maplibre-gl-csp-worker.js"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "includes": [
      "**",
      "!docs/kraft-gauntlet/source-data/geo-osm-source.json",
      "!docs/kraft-gauntlet/source-data/geo-osm-source-2026-09-30.json",
      "!docs/kraft-gauntlet/source-data/geo-placement-review-2026-10-01.json",
      "!docs/kraft-gauntlet/source-data/geo-rendered-map-review-2026-10-01.json",
      "!docs/kraft-gauntlet/source-data/geo-surface-candidates-2026-10-01.json",
      "!docs/kraft-gauntlet/source-data/geo-candidate-surface-review-2026-10-01.json",
      "!docs/kraft-gauntlet/source-data/geo-surface-review-2026-10-01.json",
      "!public/kraft/geo-features.json",
      "!public/kraft/geo-surface-candidates.json"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "lineWidth": 1
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUndeclaredDependencies": "off",
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noImportCycles": "error"
      },
      "recommended": true,
      "style": {
        "noInferrableTypes": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noNonNullAssertion": "off",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "off"
      },
      "suspicious": {
        "noVar": "on",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
